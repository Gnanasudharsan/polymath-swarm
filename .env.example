# Copy to .env and fill in. Never commit .env.

# --- LLM providers (LiteLLM) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_API_BASE=http://localhost:11434

# --- Literature APIs ---
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=
OPENALEX_API_KEY=

# --- Datastores (match docker-compose.yml) ---
POLYMATH_POSTGRES_DSN=postgresql://polymath:polymath@localhost:5544/polymath
POLYMATH_REDIS_URL=redis://localhost:6379/0

# --- Observability (Phase 6) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- API (Phase 7) ---
POLYMATH_API_KEY=

# --- Polymath overrides (optional; see src/polymath/core/config.py) ---
# POLYMATH_LOG_LEVEL=INFO
# POLYMATH_ROLE_MODELS={"reasoner": "claude-opus-5-5", "critic": "claude-sonnet-5-5"}
# POLYMATH_FALLBACK_MODELS=["gpt-5", "gemini/gemini-2.5-pro"]
# POLYMATH_DEGRADED_MODEL=claude-haiku-5-5
# POLYMATH_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
